# Copy to .env and fill in. Never commit the real .env file.

# --- Core ---
JARVIS_ENV=development
JARVIS_LOG_LEVEL=INFO
JARVIS_SECRET_KEY=change-me-to-a-random-value
JARVIS_WORKSPACE_DIR=./workspace

# --- API ---
JARVIS_API_HOST=0.0.0.0
JARVIS_API_PORT=8000
JARVIS_CORS_ORIGINS=http://localhost:3000

# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jarvis
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=jarvis

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- ChromaDB ---
CHROMA_HOST=localhost
CHROMA_PORT=8001

# --- LLM providers (fill in what you use) ---
ANTHROPIC_API_KEY=
JARVIS_ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
JARVIS_DEFAULT_LLM_PROVIDER=anthropic

# --- Voice (optional, phase 5) ---
ELEVENLABS_API_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
